rules_version = '2';

/* ============================================================
   firestore.rules — reglas del Calendario

   CÓMO PUBLICARLAS:
     Firebase → Firestore Database → pestaña «Reglas» → pega todo
     este archivo → Publicar.

   El correo de administrador ya está puesto (leonnnc@gmail.com) y es el
   mismo que PANEL.adminEmail en js/firebase-config.js. Ese correo es el
   único que podrá ver la lista de IPs: si algún día cambias de cuenta,
   cámbialo en los DOS archivos.

   Qué protege cada cosa:
     · users/{uid}                  solo tú (y el administrador)
     · usuarios_publicos/{uid}      lo lee cualquiera con sesión, pero
                                    SOLO tiene alias y correo: tu
                                    teléfono y tus apellidos no salen
                                    nunca de tu documento privado
     · users/{uid}/calendario       tú, o quien tú invites (con permiso
                                    de ver o de editar)
     · compartidos/{tú}/recibidos/{dueño}
                                    la invitación: la escribe el dueño
                                    (la palabra 'recibidos' es lo que la
                                    hace una ruta válida de Firestore)
     · visitas                      la puede crear cualquiera (el
                                    contador funciona sin cuenta) y
                                    solo la lee el administrador
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() { return request.auth != null; }
    function esMio(uid) { return conSesion() && request.auth.uid == uid; }
    function esAdmin() {
      return conSesion() && request.auth.token.email == 'leonnnc@gmail.com';
    }
    /* ¿Existe una invitación de {dueno} para mí?
       La ruta lleva 'recibidos' a propósito: en Firestore las colecciones
       ocupan las posiciones impares y los documentos las pares. */
    function invitacion(dueno) {
      return exists(/databases/$(database)/documents/compartidos/$(request.auth.uid)/recibidos/$(dueno));
    }
    function puedoEditar(dueno) {
      return invitacion(dueno) &&
        get(/databases/$(database)/documents/compartidos/$(request.auth.uid)/recibidos/$(dueno)).data.rol == 'editar';
    }

    /* ---------- perfil privado ---------- */
    match /users/{uid} {
      allow read, write: if esMio(uid) || esAdmin();
    }

    /* ---------- copia pública: alias y correo, nada más ---------- */
    match /usuarios_publicos/{uid} {
      allow read: if conSesion() || esAdmin();
      allow create, update: if esMio(uid)
        && request.resource.data.keys().hasOnly(['uid', 'alias', 'correo', 'actualizado'])
        && request.resource.data.alias is string
        && request.resource.data.correo is string
        && request.resource.data.alias.size() <= 40
        && request.resource.data.correo.size() <= 120;
      allow delete: if esMio(uid) || esAdmin();
    }

    /* ---------- el calendario de cada uno ---------- */
    match /users/{uid}/calendario/{docId} {
      allow read: if esMio(uid) || esAdmin() || invitacion(uid);
      allow write: if esMio(uid) || esAdmin() || puedoEditar(uid);
    }

    /* ---------- a quién le he compartido yo ---------- */
    match /users/{uid}/invitados/{invitado} {
      allow read, write: if esMio(uid) || esAdmin();
      /* El invitado puede retirarse por su cuenta de la lista del dueño. */
      allow delete: if esMio(invitado);
    }

    /* ---------- invitaciones recibidas ---------- */
    /* compartidos/{invitado}/recibidos/{dueno}: el dueño la crea, el
       invitado la lee, y cualquiera de los dos puede borrarla (dejar de
       compartir). */
    match /compartidos/{invitado}/recibidos/{dueno} {
      allow read: if esMio(invitado) || esMio(dueno) || esAdmin();
      allow create, update: if conSesion()
        && request.resource.data.keys().hasOnly(['de', 'para', 'correo', 'alias', 'rol', 'desde'])
        && request.resource.data.de == request.auth.uid
        && request.resource.data.para == invitado
        && request.resource.data.rol in ['ver', 'editar'];
      allow delete: if esMio(invitado) || esMio(dueno) || esAdmin();
    }

    /* ---------- contador de visitas + IP ----------
       Cualquiera puede sumar una visita (la app se usa también sin
       cuenta), pero solo con estos campos y con estos tipos: no se
       puede usar la colección como caja de cualquier cosa.
       Solo el administrador puede leerlas. */
    match /visitas/{visita} {
      allow create: if request.resource.data.keys().hasOnly([
          'ip', 'pais', 'ciudad', 'region', 'proveedor', 'navegador', 'sistema',
          'idioma', 'pantalla', 'zona', 'pagina', 'uid', 'fecha'
        ])
        && request.resource.data.ip is string
        && request.resource.data.ip.size() <= 45
        && request.resource.data.navegador is string
        && request.resource.data.fecha is number;
      allow read, update, delete: if esAdmin();
    }
  }
}
